{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "C:/Users/%USERPROFILE%/.config/fastfetch/ascii.txt",

    "color": {
      "1": "#0F5FAF",
      "2": "#2F7FD1",
      "3": "#5DA9F6",
      "4": "#A9D4FF",
      "5": "#F4FAFF",
      "6": "#D6ECFF",
      "7": "#7BBEFF",
      "8": "#3B8EEA",
      "9": "#1E4F9C"
    },

    "padding": {
      "top": 1,
      "right": 3
    }
  },

  "display": {
    "separator": " "
  },

  "modules": [
    "break",

    {
      "type": "title",

      "color": {
        "user": "#7DC4FF",
        "at": "#F4FAFF",
        "host": "#3B8EEA"
      }
    },

    "break",

    {
      "type": "os",
      "key": "",
      "keyColor": "#3B8EEA"
    },

    {
      "type": "uptime",
      "key": "󰅐",
      "keyColor": "#A9D4FF"
    },

    {
      "type": "cpu",
      "key": "",
      "keyColor": "#5DA9F6"
    },

    {
      "type": "gpu",
      "key": "󰢮",
      "keyColor": "#7BBEFF"
    },

    {
      "type": "board",
      "key": "󰚗",
      "keyColor": "#2F7FD1"
    },

    {
      "type": "memory",
      "key": "",
      "keyColor": "#D6ECFF",
      "format": "{used} / {total} ({percentage})"
    },

    {
      "type": "disk",
      "key": "",
      "keyColor": "#5DA9F6"
    },

    "break",

    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
